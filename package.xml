<?xml version="1.0"?>
<package format="3">
  <name>comrob2021_welding</name>
  <version>1.0.0</version>
  <description>Gazebo simulation of a Fanuc ARC Mate 100iC welding robot working with a 2-DOF positioner (COMRob 2021).</description>
  <maintainer email="contact@juliordz.com">Julio Cesar Rodriguez Cervantes</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
