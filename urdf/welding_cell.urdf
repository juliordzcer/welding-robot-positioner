<?xml version="1.0"?>
<!-- Welding cell of the paper "Optimal Motions of a Welding Robot for
     Cooperative Tasks with a 2 DOF Positioner" (COMRob 2021).
     World frame = workstation frame Sigma_e of the paper.
     Robot meshes: ROS-Industrial fanuc_m10ia_support (BSD-3-Clause). -->
<robot name="welding_cell">
  <material name="fanuc_yellow"><color rgba="0.96 0.76 0.13 1"/></material>
  <material name="fanuc_gray"><color rgba="0.4 0.4 0.4 1"/></material>
  <material name="fanuc_black"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="steel"><color rgba="0.62 0.64 0.67 1"/></material>
  <material name="dark"><color rgba="0.22 0.24 0.27 1"/></material>
  <material name="blue"><color rgba="0.13 0.33 0.62 1"/></material>
  <material name="seam"><color rgba="0.85 0.25 0.1 1"/></material>
  <material name="copper"><color rgba="0.8 0.45 0.2 1"/></material>

  <link name="world"/>

  <!-- Pedestal of the robot: Sigma_0 is 0.45 m above Sigma_e (eq. 2) -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/><child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="pedestal">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 -0.375"/><geometry><box size="0.45 0.45 0.75"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="world_to_pedestal" type="fixed">
    <parent link="world"/><child link="pedestal"/><origin xyz="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/visual/base_link.stl"/></geometry><material name="fanuc_gray"/></visual>
    <collision><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/collision/base_link.stl"/></geometry></collision>
  </link>
  <link name="link_1">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/visual/link_1.stl"/></geometry><material name="fanuc_yellow"/></visual>
    <collision><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/collision/link_1.stl"/></geometry></collision>
  </link>
  <link name="link_2">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/visual/link_2.stl"/></geometry><material name="fanuc_yellow"/></visual>
    <collision><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/collision/link_2.stl"/></geometry></collision>
  </link>
  <link name="link_3">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/visual/link_3.stl"/></geometry><material name="fanuc_yellow"/></visual>
    <collision><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/collision/link_3.stl"/></geometry></collision>
  </link>
  <link name="link_4">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/visual/link_4.stl"/></geometry><material name="fanuc_yellow"/></visual>
    <collision><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/collision/link_4.stl"/></geometry></collision>
  </link>
  <link name="link_5">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/visual/link_5.stl"/></geometry><material name="fanuc_yellow"/></visual>
    <collision><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/collision/link_5.stl"/></geometry></collision>
  </link>
  <link name="link_6">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/visual/link_6.stl"/></geometry><material name="fanuc_black"/></visual>
    <collision><geometry><mesh filename="package://comrob2021_welding/meshes/m10ia/collision/link_6.stl"/></geometry></collision>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0.450" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="1000" velocity="10"/>
  </joint>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="0.150 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="2.79" effort="1000" velocity="10"/>
  </joint>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="0 0 0.600" rpy="0 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="-3.14" upper="4.61" effort="1000" velocity="10"/>
  </joint>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/><child link="link_4"/>
    <origin xyz="0 0 0.200" rpy="0 0 0"/><axis xyz="-1 0 0"/>
    <limit lower="-3.31" upper="3.31" effort="1000" velocity="10"/>
  </joint>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/>
    <origin xyz="0.640 0 0" rpy="0 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="-3.31" upper="3.31" effort="1000" velocity="10"/>
  </joint>
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/><child link="link_6"/>
    <origin xyz="0.100 0 0" rpy="0 0 0"/><axis xyz="-1 0 0"/>
    <limit lower="-6.28" upper="6.28" effort="1000" velocity="10"/>
  </joint>

  <!-- Welding torch (Fig. 2): tip at 0.504 m from the wrist centre, bent 22 deg -->
  <link name="torch">
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><origin xyz="0.025 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.045" length="0.05"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="0.17 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.02" length="0.26"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="0.352 0 -0.0249" rpy="0 2.0184 0"/><geometry><cylinder radius="0.016" length="0.115"/></geometry><material name="copper"/></visual>
  </link>
  <joint name="link_6_to_torch" type="fixed">
    <parent link="link_6"/><child link="torch"/><origin xyz="0 0 0"/>
  </joint>
  <link name="torch_tip">
    <inertial><mass value="0.01"/><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/></inertial>
    <visual><geometry><sphere radius="0.008"/></geometry><material name="seam"/></visual>
  </link>
  <joint name="torch_to_tip" type="fixed">
    <parent link="torch"/><child link="torch_tip"/>
    <origin xyz="0.4040 0 -0.0498" rpy="3.14159265 -1.18682389 0"/>
  </joint>

  <!-- 2-DOF positioner. Sigma_m0 placed with eq. (3) -->
  <link name="positioner_stand">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="1.2 0.5 -0.73"/><geometry><box size="0.9 0.6 0.04"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="0.83 0.5 -0.37"/><geometry><box size="0.12 0.2 0.72"/></geometry><material name="blue"/></visual>
    <visual><origin xyz="1.57 0.5 -0.37"/><geometry><box size="0.12 0.2 0.72"/></geometry><material name="blue"/></visual>
  </link>
  <joint name="world_to_stand" type="fixed">
    <parent link="world"/><child link="positioner_stand"/><origin xyz="0 0 0"/>
  </joint>
  <link name="positioner_base">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 -0.37"/><geometry><cylinder radius="0.06" length="0.05"/></geometry><material name="steel"/></visual>
    <visual><origin xyz="0 0 0.37"/><geometry><cylinder radius="0.06" length="0.05"/></geometry><material name="steel"/></visual>
  </link>
  <joint name="stand_to_base" type="fixed">
    <parent link="world"/><child link="positioner_base"/>
    <origin xyz="1.2 0.5 -0.01" rpy="1.57079633 0 1.57079633"/>
  </joint>
  <link name="positioner_link_1">
    <inertial><mass value="5"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.74"/></geometry><material name="steel"/></visual>
    <visual><origin xyz="0 0.035 0"/><geometry><box size="0.3 0.07 0.3"/></geometry><material name="blue"/></visual>
    <visual><origin xyz="0 0.085 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.12" length="0.05"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="positioner_joint_1" type="revolute">
    <parent link="positioner_base"/><child link="positioner_link_1"/>
    <origin xyz="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="2"/>
  </joint>
  <link name="positioner_link_2">
    <inertial><mass value="5"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
    <visual><origin xyz="0 0 -0.015"/><geometry><cylinder radius="0.25" length="0.03"/></geometry><material name="steel"/></visual>
    <visual><origin xyz="0.2 0 0.0"/><geometry><box size="0.04 0.04 0.012"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="0 0 0.225"/><geometry><cylinder radius="0.1" length="0.45"/></geometry><material name="steel"/></visual>
    <visual><origin xyz="0.10143 0.00266 0.00188" rpy="0 0.95626 1.59698"/><geometry><cylinder radius="0.004" length="0.00683"/></geometry><material name="seam"/></visual>
    <visual><origin xyz="0.10115 0.00796 0.00563" rpy="0 0.95626 1.64934"/><geometry><cylinder radius="0.004" length="0.00683"/></geometry><material name="seam"/></visual>
